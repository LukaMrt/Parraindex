includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/shipmonk/phpstan-rules/rules.neon
    - vendor/shipmonk/dead-code-detector/rules.neon

services:
    -
        class: App\Tests\PHPStan\AppUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider

parameters:
    # Directories to be analyzed
    paths:
        - src
        - tests

    # Level 0 is the loosest, level 10 is the strictest
    level: 10

    # Cache configuration for better performance
    tmpDir: var/cache/phpstan
    resultCachePath: var/cache/phpstan/resultCache.php

    # Exclude specific files or directories from analysis
    excludePaths:
        - */old/*
        - */Application/*
        - */tests/bootstrap.php

    # Container compilé (bin/console cache:warmup) : utilisé par phpstan-symfony
    # et par dead-code-detector pour savoir quels services/constructeurs le DIC appelle.
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    shipmonkDeadCode:
        usageExcluders:
            # Un membre de src/ utilisé uniquement par les tests est considéré mort
            tests:
                enabled: true

    # Report uninitialized properties
    checkUninitializedProperties: true

    # Enable stricter checks for arrays
    checkExplicitMixed: true

    # Check missing parameter types
    checkMissingCallableSignature: true

    # Additional strict rules
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkDynamicProperties: true
    checkBenevolentUnionTypes: true
    reportAlwaysTrueInLastCondition: true
    reportIgnoresWithoutComments: true

    # Exceptions de programmation/exécution non vérifiées (convention standard) :
    # utilisé par shipmonk.checkedExceptionInCallable
    exceptions:
        uncheckedExceptionClasses:
            - LogicException
            - RuntimeException
